+/** Creates the interface aName of aKind over netlink (RTM_NEWLINK); 0, or the negative errno the kernel answered. */
+static int createLink(const char *aName, const char *aKind)
+{
+    struct
+    {
+        struct nlmsghdr  nh;
+        struct ifinfomsg ifi;
+        char             buf[128];
+    } req;
+    struct rtattr *linkInfo;
+    char           ack[256];
+    int            fd;
+    int            code;
+
+    memset(&req, 0, sizeof(req));
+    req.nh.nlmsg_len    = NLMSG_LENGTH(sizeof(struct ifinfomsg));
+    req.nh.nlmsg_type   = RTM_NEWLINK;
+    req.nh.nlmsg_flags  = NLM_F_REQUEST | NLM_F_CREATE | NLM_F_EXCL | NLM_F_ACK;
+    req.ifi.ifi_family  = AF_UNSPEC;
+    AddRtAttr(&req.nh, sizeof(req), IFLA_IFNAME, aName, static_cast<uint8_t>(strlen(aName) + 1));
+    linkInfo = AddRtAttr(&req.nh, sizeof(req), IFLA_LINKINFO, nullptr, 0);
+    AddRtAttr(&req.nh, sizeof(req), IFLA_INFO_KIND, aKind, static_cast<uint8_t>(strlen(aKind) + 1));
+    linkInfo->rta_len = static_cast<unsigned short>(reinterpret_cast<char *>(&req.nh) + req.nh.nlmsg_len -
+                                                    reinterpret_cast<char *>(linkInfo));
+
+    fd = SocketWithCloseExec(AF_NETLINK, SOCK_RAW, NETLINK_ROUTE, kSocketBlock);
+    VerifyOrDie(fd >= 0, OT_EXIT_ERROR_ERRNO);
+    VerifyOrDie(send(fd, &req, req.nh.nlmsg_len, 0) == static_cast<ssize_t>(req.nh.nlmsg_len), OT_EXIT_ERROR_ERRNO);
+    code = 0;
+    if (recv(fd, ack, sizeof(ack), 0) > 0)
+    {
+        const struct nlmsghdr *nh = reinterpret_cast<const struct nlmsghdr *>(ack);
+        if (nh->nlmsg_type == NLMSG_ERROR)
+        {
+            code = reinterpret_cast<const struct nlmsgerr *>(NLMSG_DATA(nh))->error;
+        }
+    }
+    close(fd);
+    return code;
+}
+
+/**
+ * The Thread interface without tun: a dummy interface, or, on kernels built without dummy interfaces (the Ruckus 6.1.0
+ * and older AP firmware), an empty bridge, which every AP kernel has. Neither sends packets anywhere; the packet socket
+ * sees what the kernel routes into either. A bridge resolves neighbours, so ARP/ND is switched off on it (IFF_NOARP,
+ * as a dummy interface has it).
+ */
+static void createThreadLink(const char *aName)
+{
+    int          code = createLink(aName, "dummy");
+    struct ifreq ifr;
+
+    if (code == 0)
+    {
+        return;
+    }
+    otLogNotePlat("[netif] No dummy interfaces (%s): %s is an empty bridge instead", strerror(-code), aName);
+    code = createLink(aName, "bridge");
+    if (code != 0)
+    {
+        otLogCritPlat("[netif] Creating %s: %s", aName, strerror(-code));
+        DieNow(OT_EXIT_FAILURE);
+    }
+    memset(&ifr, 0, sizeof(ifr));
+    strncpy(ifr.ifr_name, aName, IFNAMSIZ - 1);
+    VerifyOrDie(ioctl(sIpFd, SIOCGIFFLAGS, &ifr) == 0, OT_EXIT_ERROR_ERRNO);
+    ifr.ifr_flags |= IFF_NOARP;
+    VerifyOrDie(ioctl(sIpFd, SIOCSIFFLAGS, &ifr) == 0, OT_EXIT_ERROR_ERRNO);
+}
+
+/** No tun driver: the Thread interface is a dummy interface (or an empty bridge), served by a packet socket and a raw IPv6 socket. */
+static void platformConfigureDummyNetif(otPlatformConfig *aPlatformConfig)
+{
+    struct ifreq       ifr;
+    struct sockaddr_ll sll;
+    const char        *name = aPlatformConfig->mInterfaceName ? aPlatformConfig->mInterfaceName : "wpan0";
+    unsigned int       index;
+
+    VerifyOrDie(strlen(name) < IFNAMSIZ, OT_EXIT_INVALID_ARGUMENTS);
+    strncpy(gNetifName, name, sizeof(gNetifName));
+    if (if_nametoindex(name) == 0)
+    {
+        createThreadLink(name);
+    }
+    index = if_nametoindex(name);
+    VerifyOrDie(index != 0, OT_EXIT_ERROR_ERRNO);
+
+    // Firmware that creates interfaces with IPv6 disabled (net.ipv6.conf.default.disable_ipv6 = 1) would refuse the
+    // Thread addresses and never send into the interface.
+    {
+        char path[96];
+        int  fd;
+
+        snprintf(path, sizeof(path), "/proc/sys/net/ipv6/conf/%s/disable_ipv6", name);
+        fd = open(path, O_WRONLY | O_CLOEXEC);
+        VerifyOrDie(fd >= 0 && write(fd, "0", 1) == 1, OT_EXIT_ERROR_ERRNO);
+        close(fd);
+    }
+
+    // Outgoing packets reach only packet sockets of every protocol (ETH_P_ALL); processTransmit() keeps IPv6.
+    sTunFd = SocketWithCloseExec(AF_PACKET, SOCK_DGRAM, htons(ETH_P_ALL), kSocketNonBlock);
+    VerifyOrDie(sTunFd >= 0, OT_EXIT_ERROR_ERRNO);
+    memset(&sll, 0, sizeof(sll));
+    sll.sll_family   = AF_PACKET;
+    sll.sll_protocol = htons(ETH_P_ALL);
+    sll.sll_ifindex  = static_cast<int>(index);
+    VerifyOrDie(bind(sTunFd, reinterpret_cast<struct sockaddr *>(&sll), sizeof(sll)) == 0, OT_EXIT_ERROR_ERRNO);
+
+    sRawFd = SocketWithCloseExec(AF_INET6, SOCK_RAW, IPPROTO_RAW, kSocketNonBlock);
+    VerifyOrDie(sRawFd >= 0, OT_EXIT_ERROR_ERRNO);
+    sDummyNetif = true;
+
+    memset(&ifr, 0, sizeof(ifr));
+    strncpy(ifr.ifr_name, name, IFNAMSIZ - 1);
+    ifr.ifr_mtu = static_cast<int>(kMaxIp6Size);
+    VerifyOrDie(ioctl(sIpFd, SIOCSIFMTU, static_cast<void *>(&ifr)) == 0, OT_EXIT_ERROR_ERRNO);
+    otLogNotePlat("[netif] No tun driver: %s is a stand-in interface (packet socket in, raw IPv6 socket out)", name);
+}
