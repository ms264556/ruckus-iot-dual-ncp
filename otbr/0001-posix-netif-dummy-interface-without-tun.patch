+#if defined(__linux__)
+/**
+ * A packet from Thread, through the raw socket: routed by the kernel as locally sent, so it goes out of the
+ * infrastructure link or, for one of this host's own addresses, is delivered locally. Link- and interface-scope
+ * unicast and all multicast belong to the Thread interface itself, which a raw socket cannot deliver as received
+ * there, so they are dropped.
+ */
+static otError sendToHost(const uint8_t *aPacket, uint16_t aLength)
+{
+    otError             error = OT_ERROR_NONE;
+    struct sockaddr_in6 dst;
+    const uint8_t      *dstAddr = aPacket + 24;
+
+    VerifyOrExit(aLength >= 40 && (aPacket[0] >> 4) == 6, error = OT_ERROR_PARSE);
+    VerifyOrExit(dstAddr[0] != 0xff && !(dstAddr[0] == 0xfe && (dstAddr[1] & 0xc0) == 0x80));
+
+    memset(&dst, 0, sizeof(dst));
+    dst.sin6_family = AF_INET6;
+    memcpy(&dst.sin6_addr, dstAddr, sizeof(dst.sin6_addr));
+    if (sendto(sRawFd, aPacket, aLength, 0, reinterpret_cast<struct sockaddr *>(&dst), sizeof(dst)) != aLength)
+    {
+        otLogDebgPlat("[netif] raw send: %s", strerror(errno));
+        error = OT_ERROR_FAILED;
+    }
+
+exit:
+    return error;
+}
+#endif
